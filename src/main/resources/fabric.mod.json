{
  "schemaVersion": 1,
  "id": "vulkanboost",
  "version": "${version}",
  "name": "VulkanBoost",
  "description": "A single-JAR optimization bundle for Minecraft 1.21.11 with VulkanMod, unmodified BetterHurtCam, and an experimental one-switch FSR 1 image-enhancement option.",
  "authors": [
    "golomidovmihail279-crypto"
  ],
  "contact": {
    "homepage": "https://github.com/golomidovmihail279-crypto/vulkanboost",
    "sources": "https://github.com/golomidovmihail279-crypto/vulkanboost",
    "issues": "https://github.com/golomidovmihail279-crypto/vulkanboost/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "vulkanmod:mod_settings_registry": [
      "dev.vulkanboost.VulkanBoostSettingsFactory"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "vulkanmod": ">=0.6.8",
    "fabric-api": "*",
    "betterhurtcam": ">=1.12.0",
    "ukulib": "^1.10.0",
    "renderscale": "*"
  }
}
